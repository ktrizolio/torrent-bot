# Copie este arquivo para ".env" (na mesma pasta) e preencha. NUNCA compartilhe o .env.

# ===================== SCRAPER =====================
# Horário diário da atualização do banco, formato HH:MM (fuso do container: America/Sao_Paulo)
HORARIO_DIARIO=00:00
# Alternativa: atualizar a cada N horas (só vale se HORARIO_DIARIO estiver vazio)
INTERVALO_HORAS=6
# Endereço do site WordPress a coletar (ex.: https://exemplo.com)
SITE_URL=
# 1 = resolve o domínio do site pela DNS da Cloudflare (DNS-over-HTTPS) em vez da DNS do provedor
USAR_DNS_CLOUDFLARE=1

# ======================= BOT =======================
# Token do @BotFather
TELEGRAM_TOKEN=

# 1 = qualquer pessoa pode usar o bot (e enviar downloads ao seu qBittorrent). 0 = só os IDs abaixo.
BOT_PUBLICO=0

# IDs do Telegram autorizados a usar o bot, separados por vírgula (ignorado se BOT_PUBLICO=1).
# Para descobrir o seu: mande /start ao bot e ele responde com o seu ID.
ALLOWED_USER_IDS=

# qBittorrent (Web UI)
QBIT_HOST=localhost
QBIT_PORT=8080
QBIT_USERNAME=
QBIT_PASSWORD=

# Categorias criadas no qBittorrent para cada tipo
QBIT_CATEGORIA_FILMES=Filmes
QBIT_CATEGORIA_SERIES=Series
QBIT_CATEGORIA_ANIMES=Series
QBIT_CATEGORIA_OUTROS=Outros

# Pastas da biblioteca, COMO O QBITTORRENT AS VÊ. Os downloads vão para
#   PASTA_FILMES/Título (Ano)/Título (Ano).mkv  e  PASTA_SERIES/Título (Ano)/Season 01/Título S01E01.mkv
PASTA_FILMES=/Media/Filmes
PASTA_SERIES=/Media/Series
# Pasta padrão de cada categoria no qBittorrent (opcional; só vale para o que não é filme/série)
QBIT_PASTA_FILMES=
QBIT_PASTA_SERIES=
QBIT_PASTA_ANIMES=

# Catálogo do Jellyfin: chave compartilhada entre o bot (API na porta CATALOGO_PORTA) e o plugin
# "Catálogo (baixar)". Gere uma aleatória; vazio desliga a API.
CATALOGO_TOKEN=
CATALOGO_PORTA=8099
# Endereço do Jellyfin visto pelo bot (para os avisos de 50% / 100% aos usuários)
JELLYFIN_URL=http://127.0.0.1:8096
# Horário diário da regeneração do Catálogo (depois da coleta)
HORA_CATALOGO=00:40
# Pasta do servidor onde o Catálogo é gerado (o Jellyfin precisa enxergá-la; ver PastaCatalogo no plugin)
PASTA_CATALOGO_HOST=./catalogo
